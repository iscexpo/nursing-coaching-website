DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"
# Legacy BETTER_AUTH_* names are still accepted as a fallback.
ISC_AUTH_SECRET="generate-a-random-secret-here"
ISC_AUTH_URL="https://www.iscexpo.edu.bd"
ISC_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://iscexpo.edu.bd,https://www.iscexpo.edu.bd"

# Supabase (for OTP SMS via Edge Function)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Email delivery for password-reset links (Resend). Without a key,
# dev logs the reset link to the server console; production errors loudly.
RESEND_API_KEY=""
EMAIL_FROM="ISC Expo <noreply@iscexpo.edu.bd>"

# Vercel Blob (media file storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Site URL and branding (override defaults)
NEXT_PUBLIC_SITE_URL="https://www.iscexpo.edu.bd"
NEXT_PUBLIC_SITE_NAME="ISC Expo - Icon Skill & Career Expo"
NEXT_PUBLIC_SITE_NAME_BN="ISC Expo - Icon Skill & Career Expo"
NEXT_PUBLIC_SITE_EMAIL="info@iscexpo.edu.bd"

# Admin seed endpoint (generate a random key for production)
ADMIN_SEED_KEY=change-me-to-a-random-string
ADMIN_EMAIL="admin@khulnasoft.com"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_PHONE="+8801XXXXXXXXX"
ADMIN_NAME="Admin"

# Grameenphone Bulk SMS (configure in Admin > Settings > SMS)
# GP_SMS_API_BASE_URL="https://api.gp-sms.com.bd/bulk-sms/api"

# SAS Bulk SMS (configure in Admin > Settings > SMS)
# SAS_SMS_API_BASE_URL="https://api.sasbulksms.com/api/v1"

# Shiram System SMS V1.70 (configure in Admin > Settings > SMS)
# Provider docs: docs/Shiram-SMS-API-V1.70.md
# SHIRAM_SMS_API_BASE_URL="https://smsapi.shiramsystem.com/user_api/"
# Shiram credentials (email/password + senderId/mask) are stored in DB via Admin Settings.
# Mask examples: 'Non-Masking' (without masking), or your approved mask name.

# SMS settings (apiKey, senderId) are stored in the database via Admin Settings
